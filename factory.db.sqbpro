CREATE TABLE Supplier (
  SupplierID INTEGER PRIMARY KEY,
  SupplierName VARCHAR(100),
  ContactDetails VARCHAR(100)
);

CREATE TABLE Machinery (
  MachineryID INTEGER PRIMARY KEY,
  SupplierID INTEGER,
  MachineryName VARCHAR(100),
  Specifications VARCHAR(255),
  FOREIGN KEY (SupplierID) REFERENCES Supplier(SupplierID)
);

CREATE TABLE Stress_test (
  StressID INTEGER PRIMARY KEY,
  StressDate DATE,
  Description TEXT,
  Status BOOLEAN
);

CREATE TABLE Quality_control (
  QualityID INTEGER PRIMARY KEY,
  QualityDate DATE,
  Description TEXT,
  Status BOOLEAN
);

CREATE TABLE Laser_scans (
  LaserID INTEGER PRIMARY KEY,
  LaserDate DATE,
  Description TEXT,
  Status BOOLEAN
);

CREATE TABLE Initial_check (
  InitialCheckID INTEGER PRIMARY KEY,
  MachineryID INTEGER,
  RecordDate DATE,
  StressID INTEGER,
  QualityID INTEGER,
  LaserID INTEGER,
  FOREIGN KEY (MachineryID) REFERENCES Machinery(MachineryID),
  FOREIGN KEY (StressID)    REFERENCES Stress_test(StressID),
  FOREIGN KEY (QualityID)   REFERENCES Quality_control(QualityID),
  FOREIGN KEY (LaserID)     REFERENCES Laser_scans(LaserID)
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
